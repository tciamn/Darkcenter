# Google Sheets API credentials
# The tool fetches live data from a public Google Sheet.
# Without these, it falls back to data/fallback.json automatically.

# The document ID from the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<SHEETS_ID>/edit
VITE_SHEETS_ID=your_google_sheet_id_here

# A read-only Google Sheets API key (no OAuth required for public sheets)
# Create one at: https://console.cloud.google.com/apis/credentials
VITE_SHEETS_API_KEY=your_api_key_here

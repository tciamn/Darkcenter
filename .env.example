# Google Sheets credentials — required for live data fetching.
# Without these the tool uses data/fallback.json (always available).
#
# Sheet ID: the long string in the Google Sheets URL
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
#
# API Key: create at https://console.cloud.google.com/
#   Enable the "Google Sheets API" and restrict the key to that API.
#   The key only needs read access; it is safe to expose in a browser build.

VITE_SHEETS_ID=your_google_sheet_id_here
VITE_SHEETS_API_KEY=your_api_key_here

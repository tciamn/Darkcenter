# Google Sheets document ID — safe to expose (it's in the share link anyway)
VITE_SHEETS_ID=your_google_sheet_id_here

# API key — NO "VITE_" prefix so Vite never bundles it into client JS.
# In production: add this in Netlify UI → Site settings → Environment variables.
# In dev: the vite.config.js proxy reads it from .env directly (server-side only).
SHEETS_API_KEY=your_api_key_here

# Set to "true" to skip Sheets and always use data/fallback.json
# Useful for local development without credentials.
VITE_FORCE_FALLBACK=false

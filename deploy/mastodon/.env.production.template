# -----------------------------------------------
# Future Labs Mastodon — .env.production template
# -----------------------------------------------
# Copy this file to .env.production and fill in all CHANGEME values.
# NEVER commit .env.production to git. It is in .gitignore.
# Store the filled file encrypted, offline, with a second admin.
# -----------------------------------------------

# Instance hostname — no https:// prefix, no trailing slash
LOCAL_DOMAIN=futurelabs.social

# Set to true if you want web push notifications
# Requires running: docker compose run --rm web bundle exec rake mastodon:webpush:generate_vapid_key
VAPID_PRIVATE_KEY=CHANGEME
VAPID_PUBLIC_KEY=CHANGEME

# Secret key base — generate with:
# docker compose run --rm web bundle exec rails secret
SECRET_KEY_BASE=CHANGEME

# OTP secret — generate with:
# docker compose run --rm web bundle exec rails secret
OTP_SECRET=CHANGEME

# -----------------------------------------------
# Database
# -----------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------
# Object Storage (Hetzner Object Storage — S3-compatible)
# -----------------------------------------------
# Set S3_ENABLED=true to use object storage for media files.
# Strongly recommended — keeps media off the VPS disk.
S3_ENABLED=true
S3_PROTOCOL=https

# Hetzner Object Storage endpoint for your region:
# Falkenstein: fsn1.your-objectstorage.com
# Helsinki: hel1.your-objectstorage.com
# Nuremberg: nbg1.your-objectstorage.com
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_HOSTNAME=fsn1.your-objectstorage.com

# Create a bucket named 'futurelabs-mastodon' in Hetzner Object Storage console
S3_BUCKET=futurelabs-mastodon

# Generate Access Key ID and Secret in Hetzner Cloud console → Object Storage → Credentials
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# CDN / alias hostname for serving media (optional but recommended for performance)
# Leave blank to serve directly from S3
S3_ALIAS_HOST=

# -----------------------------------------------
# Email / SMTP
# -----------------------------------------------
# Mastodon needs outbound email for account confirmation, notifications, etc.
# Options: Mailgun EU, Postmark, AWS SES EU, or self-hosted (postfix via Hetzner)
# Mailgun EU recommended for simplicity + EU jurisdiction.
SMTP_SERVER=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_LOGIN=CHANGEME@futurelabs.social
SMTP_PASSWORD=CHANGEME
SMTP_FROM_ADDRESS=notifications@futurelabs.social
SMTP_AUTH_METHOD=plain
SMTP_OPENSSL_VERIFY_MODE=peer
SMTP_ENABLE_STARTTLS=always

# -----------------------------------------------
# Optional: Elasticsearch (full-text search)
# -----------------------------------------------
# Skip for initial setup. Enable later if you want full-text post search.
ES_ENABLED=false
# ES_HOST=localhost
# ES_PORT=9200

# -----------------------------------------------
# Rails environment — do not change
# -----------------------------------------------
RAILS_ENV=production
RACK_ENV=production
RAILS_LOG_LEVEL=warn
TRUSTED_PROXY_IP=127.0.0.1

# -----------------------------------------------
# Registration mode
# -----------------------------------------------
# Options: open, approved, none
# Start with 'approved' (admin reviews signups) or 'none' (invite-only)
# Change via admin UI after setup — this env var is only read at first boot
# MASTODON_OPEN_REGISTRATION is deprecated; use admin panel instead
